# ==============================================
# Docker Environment Configuration
# ==============================================
# This file contains Docker-specific defaults
# Override secrets in .env.local (gitignored)
#
# Load order: .env.local > .env.docker > .env
# ==============================================

# Application
APP_NAME="Sistema de Gestão de Vendas"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8080
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# Database (Docker MySQL Container)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=creditall_challenge
DB_USERNAME=creditall_user
# DB_PASSWORD is set in .env.local

# Broadcasting
BROADCAST_CONNECTION=log

# Cache
CACHE_STORE=redis
CACHE_PREFIX=creditall_cache

# Filesystem
FILESYSTEM_DISK=local

# Queue (Using Redis instead of database for better performance)
QUEUE_CONNECTION=redis

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Redis (Docker Container)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# Mail (Use Mailtrap for development)
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@creditall.test"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_USERNAME and MAIL_PASSWORD in .env.local

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Vite (Hot reload for development)
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
