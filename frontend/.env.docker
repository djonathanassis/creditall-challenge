# Docker Development Environment Configuration
# This file contains environment variables for Docker development

# API Configuration - Use Vite proxy for browser compatibility
VITE_API_BASE_URL=/api

# Application Configuration
VITE_APP_NAME=Sistema de Gestão de Vendas
VITE_APP_ENV=development
VITE_API_TIMEOUT=10000

# Development Settings
NODE_ENV=development

# Docker-specific file watching settings
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true

# Performance settings
VITE_HMR_OVERLAY=true
VITE_LEGACY_DEV_SSR=false